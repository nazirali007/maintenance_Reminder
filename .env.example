# Supabase connection strings — replace [YOUR-*] placeholders with values
# from Supabase Project Settings > Database > Connection string.

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma CLI for migrate/introspect.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase client SDK keys (not used by Prisma; kept for future use e.g.
# Supabase Storage). Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-PUBLISHABLE-KEY]"

# Auth.js — generate with `openssl rand -base64 33`
AUTH_SECRET="[YOUR-AUTH-SECRET]"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="[YOUR-GOOGLE-CLIENT-ID]"
AUTH_GOOGLE_SECRET="[YOUR-GOOGLE-CLIENT-SECRET]"

# Nodemailer sends via Resend's SMTP relay (smtp.resend.com) — get an API
# key at https://resend.com/api-keys, it's used as the SMTP password.
# Without a verified sending domain, EMAIL_FROM must stay
# "onboarding@resend.dev" and mail can only be sent to the address you
# signed up to Resend with (sandbox mode).
RESEND_API_KEY="[YOUR-RESEND-API-KEY]"
EMAIL_FROM="onboarding@resend.dev"

# Secret for the daily maintenance-check cron (Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET` once set on the
# Vercel project) — generate with `openssl rand -base64 33`
CRON_SECRET="[YOUR-CRON-SECRET]"

# Public site URL used for metadata, robots.txt, and sitemap.xml. Optional —
# falls back to Vercel's own deployment URL, then localhost, if unset.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Gemini API key for the in-app car-assistant chat widget — get a free key
# at https://aistudio.google.com/apikey
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
