// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  vehicles            Vehicle[]
  notifications       Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  token   String   @unique
  userId  String
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Simple fixed-window rate limiter, keyed by e.g. "otp-request:user@example.com"
// or "register:1.2.3.4". Not perfectly atomic under heavy concurrency, but
// that's an acceptable tradeoff at this app's scale.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model Vehicle {
  id             String       @id @default(cuid())
  userId         String
  brand          String
  model          String
  variant        String?
  fuelType       FuelType
  transmission   Transmission
  year           Int
  currentMileage Int
  purchaseDate   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceItems  MaintenanceItem[]
  odometerLogs      OdometerLog[]
  notifications     Notification[]

  @@index([userId])
}

model OdometerLog {
  id         String   @id @default(cuid())
  vehicleId  String
  reading    Int
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
}

model MaintenanceItem {
  id                 String    @id @default(cuid())
  vehicleId          String
  name               String
  intervalKm         Int
  lastServiceMileage Int
  lastServiceDate    DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([vehicleId])
}

enum NotificationType {
  DUE_TODAY
  DUE_SOON
  OVERDUE
  COMPLETED
  ESTIMATED_OVERDUE
  ODOMETER_UPDATE_NUDGE
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id                String             @id @default(cuid())
  userId            String
  vehicleId         String?
  type              NotificationType
  title             String
  message           String
  status            NotificationStatus @default(UNREAD)
  maintenanceItemId String?
  createdAt         DateTime           @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceItem MaintenanceItem? @relation(fields: [maintenanceItemId], references: [id], onDelete: SetNull)

  // Matches `getUnreadNotifications`'s where clause exactly.
  @@index([userId, status])
  // Matches the OVERDUE/ESTIMATED_OVERDUE dedup lookups in
  // syncOverdueNotifications and runDailyMaintenanceCheck.
  @@index([maintenanceItemId, type])
  // Matches the ODOMETER_UPDATE_NUDGE dedup lookup.
  @@index([vehicleId, type])
}
